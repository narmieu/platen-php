# Defaults for every setting. Real environment variables win over this file, and an
# uncommitted .env.local can override it for development. See the README for details.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Reverse proxies whose X-Forwarded-* headers are trusted, e.g. "private_ranges".
TRUSTED_PROXIES=

###> platen ###
# API keys accepted as the Basic auth user name or user_credentials, comma-separated.
# Empty accepts any key, or none.
PLATEN_API_KEYS=
# Base of download links, e.g. https://pdf.example.com. Empty uses the request's own URL.
PLATEN_PUBLIC_URL=
# weasyprint (Prince-like CSS paged media) or chromium (a browser).
PLATEN_DEFAULT_ENGINE=weasyprint
# Stored PDFs, the SQLite database and temporary files.
PLATEN_DATA_DIR=%kernel.project_dir%/var/data
PLATEN_GOTENBERG_URL=http://127.0.0.1:3000
# The egress proxy (platen:egress-proxy): where it listens, and how renderers reach it.
PLATEN_EGRESS_LISTEN=127.0.0.1:3128
PLATEN_EGRESS_PROXY=http://127.0.0.1:3128
PLATEN_WEASYPRINT_BINARY=weasyprint
# weasyprint-platen-server keeps WeasyPrint warm (platen:serve starts it); empty runs
# PLATEN_WEASYPRINT_BINARY once per document.
PLATEN_WEASYPRINT_SERVER=
PLATEN_QPDF_BINARY=qpdf
# Seconds per document, as DocRaptor: 60 synchronous, 600 asynchronous.
PLATEN_SYNC_TIMEOUT=60
PLATEN_ASYNC_TIMEOUT=600
# Seconds to wait for docraptorJavaScriptFinished() to return true.
PLATEN_JS_TIMEOUT=30
# Seconds per asset request.
PLATEN_FETCH_TIMEOUT=10
# Watermark test documents (test: true, the default), as DocRaptor does.
PLATEN_TEST_WATERMARK=true
# Hours an asynchronous document stays downloadable (hosted ones follow hosted_expires_at).
PLATEN_ASYNC_RETENTION_HOURS=24
PLATEN_LOG_RETENTION_DAYS=30
# Block private networks (10/8, 172.16/12, 192.168/16, loopback...) for renderer fetches.
PLATEN_BLOCK_PRIVATE_NETWORKS=false
# More networks to block, as comma-separated CIDRs.
PLATEN_BLOCKED_NETWORKS=
PLATEN_ALLOW_FILE_URLS=false
PLATEN_MAX_REQUEST_MB=100
# platen:serve: the HTTP address, and the number of render workers and HTTP workers.
PLATEN_HOST=0.0.0.0
PLATEN_PORT=8080
PLATEN_WORKERS=2
PLATEN_HTTP_WORKERS=8
###< platen ###

###> doctrine/doctrine-bundle ###
# SQLite by default, which is what the tests run on. Other Doctrine databases should
# work but are untested, and the Docker image only has the SQLite driver, e.g.
# DATABASE_URL="postgresql://platen:secret@127.0.0.1:5432/platen?serverVersion=16&charset=utf8"
DATABASE_URL="sqlite:///${PLATEN_DATA_DIR}/platen.db"
###< doctrine/doctrine-bundle ###
